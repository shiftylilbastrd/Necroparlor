[Unit]
Description=Run the BLE sensor battery check daily (currently SensorPush-HT1-specific)

[Timer]
OnCalendar=daily
# If the Pi was off/rebooting at the scheduled time, run as soon as it's back up
Persistent=true
# Spread load slightly if you ever run more than one of these
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
