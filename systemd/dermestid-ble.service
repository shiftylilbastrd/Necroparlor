[Unit]
Description=Dermestid enclosure BLE sensor listener
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dermestid
ExecStart=/usr/bin/python3 /home/pi/dermestid/ble_listener.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
