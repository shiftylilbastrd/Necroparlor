[Unit]
Description=Dermestid enclosure timelapse capture (live view is camera-streamer.service - see docs/camera-streamer-setup.md)
After=network.target camera-streamer.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dermestid
ExecStart=/usr/bin/python3 /home/pi/dermestid/camera_service.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
