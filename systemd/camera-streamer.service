[Unit]
Description=camera-streamer (hardware-accelerated USB webcam live view - see docs/camera-streamer-setup.md)
After=network.target

[Service]
Type=simple
User=pi
# EnvironmentFile is generated/regenerated by webapp.py's
# api_set_camera_settings() (state.write_camera_streamer_env()) every
# time the Config page's Camera card is saved - see
# shared_state.py's CAMERA_STREAMER_ENV_PATH. Not git-tracked, same as
# config.json - see .gitignore.
EnvironmentFile=/home/pi/dermestid/camera-streamer.env
# NEEDS CONFIRMING ON THE REAL PI - see docs/camera-streamer-setup.md's
# "before you enable this" section:
#   - ExecStart's path assumes `sudo make install` (camera-streamer's
#     own build instructions) puts the binary at /usr/local/bin/camera-streamer,
#     which was NOT directly confirmed from its docs - check with
#     `which camera-streamer` after installing and fix this line if it's
#     somewhere else.
#   - --http-port is this project's BEST GUESS at the flag name for
#     changing camera-streamer's HTTP port away from its default 8080
#     (which would collide with webapp.py's own port - see
#     shared_state.py's CAMERA_STREAMER_FORBIDDEN_PORT). This flag name
#     was NOT found documented anywhere in camera-streamer's own docs as
#     of 2026-09-14 - run `camera-streamer --help` on the Pi once it's
#     built and confirm/correct it before relying on this unit as-is.
#   - --camera-type=libcamera --camera-format=MJPEG is camera-streamer's
#     own documented recommendation for USB (not CSI) cameras - see
#     docs/v4l2-usb-mode.md in their repo and this project's own
#     docs/camera-streamer-setup.md.
ExecStart=/usr/local/bin/camera-streamer \
    --camera-path=${CAMERA_PATH} \
    --camera-type=libcamera --camera-format=MJPEG \
    --camera-width=${CAMERA_WIDTH} --camera-height=${CAMERA_HEIGHT} \
    --http-listen=0.0.0.0 --http-port=${CAMERA_STREAMER_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
