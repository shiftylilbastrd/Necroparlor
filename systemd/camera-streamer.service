[Unit]
Description=camera-streamer (hardware-accelerated USB webcam live view - see docs/camera-streamer-setup.md)
After=network.target

[Service]
Type=simple
User=pi
# EnvironmentFile is generated/regenerated by webapp.py's
# api_set_camera_settings() (state.write_camera_streamer_env()) every
# time the Config page's Camera card is saved - see
# shared_state.py's CAMERA_STREAMER_ENV_PATH. Not git-tracked, same as
# config.json - see .gitignore.
EnvironmentFile=/home/pi/dermestid/camera-streamer.env
# [2026-09-17] CONFIRMED against a real Pi + USB webcam (v0.4.2), not
# just documentation - see PROJECT_STATUS.md. All three things this
# comment used to flag as unverified guesses are now settled:
#   - Binary path /usr/local/bin/camera-streamer - confirmed via
#     `which camera-streamer` after `sudo make install`.
#   - --http-port is the real flag name (confirmed via `camera-streamer
#     --help`) - moves the HTTP port off its 8080 default, which would
#     collide with webapp.py's own port (see shared_state.py's
#     CAMERA_STREAMER_FORBIDDEN_PORT).
#   - --camera-type=v4l2, NOT libcamera as this project's docs first
#     guessed from an indirect summary of camera-streamer's own docs -
#     v4l2 is what `camera-streamer --help`'s own example command line
#     defaults to, and it's what was actually run and confirmed working
#     (real /stream + /snapshot requests, "100% live view with no
#     jitter" - see PROJECT_STATUS.md) against this project's plain USB
#     UVC webcam. libcamera is built around the Pi's CSI camera + ISP
#     pipeline, not a generic USB device - this project's earlier
#     recommendation was simply wrong.
# [2026-10-06] Added the --camera-video.* block below - see
# PROJECT_STATUS.md's 2026-10-06 entry. Without it, /video's H264
# encoder was left on whatever camera-streamer's own internal defaults
# are (not documented), which produced exactly one frame and then froze
# - confirmed on real hardware (Ryan: "video player with controls but a
# frozen frame" when opening /video directly in Safari). These are the
# exact values from `camera-streamer --help`'s own example invocation
# (confirmed via `--help | grep -i -E "h264|video"` on the real Pi),
# not guessed - --camera-video.disabled=0 is actually the existing
# default (disabled takes 0/1, defaulting to 0 = enabled) so this isn't
# what was missing; the encoding option tuning (bitrate, keyframe
# interval, profile/level, QP range) is what was never being set at all.
ExecStart=/usr/local/bin/camera-streamer \
    --camera-path=${CAMERA_PATH} \
    --camera-type=v4l2 --camera-format=MJPEG \
    --camera-width=${CAMERA_WIDTH} --camera-height=${CAMERA_HEIGHT} \
    --http-listen=0.0.0.0 --http-port=${CAMERA_STREAMER_PORT} \
    --camera-video.disabled=0 \
    --camera-video.options=video_bitrate_mode=0 \
    --camera-video.options=video_bitrate=2000000 \
    --camera-video.options=repeat_sequence_header=5000000 \
    --camera-video.options=h264_i_frame_period=30 \
    --camera-video.options=h264_level=4 \
    --camera-video.options=h264_profile=high \
    --camera-video.options=h264_minimum_qp_value=16 \
    --camera-video.options=h264_maximum_qp_value=32 \
    --camera-video.height=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
