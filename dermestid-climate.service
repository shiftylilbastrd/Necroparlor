[Unit]
Description=Dermestid enclosure climate control
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dermestid
ExecStart=/usr/bin/python3 /home/pi/dermestid/climate.py
Restart=on-failure
RestartSec=5
# Give the control loop time to finish a graceful shutdown (GPIO cleanup)
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
